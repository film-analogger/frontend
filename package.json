{
    "name": "@film-analogger/frontend",
    "version": "0.0.0",
    "packageManager": "yarn@4.12.0",
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "dev": "react-router dev",
        "start": "react-router-serve ./build/server/index.js",
        "typecheck:tsconly": "tsc --noEmit",
        "typecheck": "react-router typegen && tsc",
        "lint": "eslint -c eslint.config.mts --fix --cache",
        "lint:nocache": "eslint -c eslint.config.mts --fix",
        "lint:ci": "eslint -c eslint.config.mts -f json -o reports/lint.json",
        "prepare": "husky",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "pw": "playwright test",
        "pw:ui": "playwright test --ui",
        "pw:report": "playwright show-report",
        "pw:headed": "playwright test --headed",
        "i18n:check": "i18n-check --locales src/i18n/locales -s en -f i18next",
        "api:gen": "curl -s -H 'Accept: application/vnd.openapi+json' http://localhost:1080/docs > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts && rm openapi.json"
    },
    "lint-staged": {
        "*": "yarn lint"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/roboto": "^5.3.0",
        "@mui/icons-material": "^9.2.0",
        "@mui/material": "^9.2.0",
        "@react-router/node": "7.18.2",
        "@react-router/serve": "7.18.2",
        "axios": "^1.19.0",
        "i18next": "^25.10.10",
        "i18next-browser-languagedetector": "^8.2.1",
        "isbot": "^5.2.1",
        "keycloak-js": "^26.2.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^16.6.6",
        "react-router": "7.18.2",
        "react-scrollbars-custom": "^4.1.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/compat": "^2.1.0",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@lingual/i18n-check": "^0.9.5",
        "@playwright/test": "^1.62.1",
        "@react-router/dev": "^7.18.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/node": "^25.9.5",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/eslint-plugin": "^1.6.24",
        "commitizen": "^4.3.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-check-file": "^3.3.2",
        "eslint-plugin-filename-export": "^2.0.0",
        "eslint-plugin-i18next": "^6.1.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-naming-convention": "^2.13.0",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "jsdom": "^28.1.0",
        "lint-staged": "^16.4.0",
        "pinst": "^3.0.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.3.6",
        "vite-plugin-eslint": "^1.8.1",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.10"
    }
}
